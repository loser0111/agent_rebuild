# ---- 环境变量 ----
PORT=8080
APP_ENV=dev
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# ---- 日志 ----
# info（默认）| debug | warn | error
# debug 会额外打印「模型请求」元信息（url / model / body_bytes / messages 条数）。
LOG_LEVEL=info
# 是否打印模型请求的完整 body（含对话历史与工具输出）。
# 默认关闭：这些内容可能有数十 KB，且包含用户对话原文。
# 排查协议层问题（如 tool_calls 与 tool 结果配对是否正确）时置 1。
# LLM_DUMP_BODY=1

# ---- 前端静态托管（单端口部署）----
# 留空则只提供 /api 接口（配合 make dev 的 Vite 开发服务器使用）。
# 设为 web/dist 可让 Go 服务直接托管前端，单端口访问 http://localhost:8080
# WEB_DIR=web/dist

# ---- 存储：memory（重启丢失）| sqlite（持久化，推荐）----
STORE_DRIVER=sqlite
MAX_MESSAGES_PER_SESSION=200
# 数据目录（SQLite 数据库位置）；留空使用平台默认：
#   macOS: ~/Library/Application Support/agent-rebuild
#   Linux: ~/.local/share/agent-rebuild
#   Windows: %LOCALAPPDATA%\agent-rebuild
# DATA_DIR=

# ---- SSE
SSE_PING_INTERVAL=15s
SSE_BUFFER_SIZE=10000
# 每个订阅者的事件队列缓冲大小（防止缓冲溢出导致消息丢失）
SSE_SUBSCRIBER_BUFFER_SIZE=4096
# 单条消息的 delta 事件最大缓冲数（防止超长文本导致内存爆炸）
SSE_MAX_MESSAGE_DELTA_CHUNKS=50000

# ---- 生成时限 ----
RUN_TIMEOUT=180s
LLM_TIMEOUT=120s

# ---- LLM：默认 mock 零配置即可跑通 Demo ----
# 两个维度：协议决定 Runner，服务商决定端点与默认模型
# LLM_PROTOCOL 留空则按 provider 自动推断（向后兼容）
#   协议: openai(默认) | anthropic | mock
#   服务商: openai | anthropic(claude) | deepseek | moonshot(kimi) | zhipu(glm)
#          qwen(通义) | siliconflow | openrouter | groq | ollama | vllm | lmstudio
LLM_PROVIDER=mock
# LLM_PROTOCOL=anthropic
# 以下两项留空即自动使用所选 provider 的预设值
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# 云端服务商必填；本地部署（ollama/vllm/lmstudio）可填任意占位值
# OPENAI_API_KEY=sk-xxxx

# 可选：覆盖系统提示词
# SYSTEM_PROMPT=你是一个严谨的中文助手

# ---- 工具系统（参考 Codex / Claude Code）----
# 工具可访问的根目录（安全边界，所有文件/命令都限制在此）。
# 留空 = 用户主目录（不是"当前工作目录"：后者在桌面端会是 app 包内的
# 子目录，导致文件操作被意外限制）。建议显式指定你要操作的项目路径：
# TOOL_WORKSPACE=/Users/you/projects/my-app
# 是否启用命令执行工具（危险操作，默认关闭）
# ENABLE_COMMAND_TOOL=false
# 单次对话最多几轮「模型→工具」迭代（防死循环）
# MAX_TOOL_STEPS=12
# 单个工具执行超时
# TOOL_TIMEOUT=120s

# ---- 审批模式（见 docs/12-approval-modes.md）----
# manual（默认，最安全）：一切需要审批的写操作都挂起等人工在前端点批准/拒绝
# model：由一次独立的模型调用（judge）当场裁决，不打断用户
# auto：完全自动放行，命令执行仍受 ENABLE_COMMAND_TOOL 单独把关
# APPROVAL_MODE=manual
# model 模式下单次裁决超时
# JUDGE_TIMEOUT=10s
# model 模式下 judge 调用失败/超时时是否放行（默认 false=拒绝，更安全）
# JUDGE_FAIL_OPEN=false
